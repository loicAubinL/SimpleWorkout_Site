Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /projet/

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^([a-z][a-z0-9-]*)/([A-Za-z0-9-]+)/?$ index.php?action=$1&id=$2 [QSA,L]
RewriteRule ^([a-z][a-z0-9-]*)/?$ index.php?action=$1 [QSA,L]